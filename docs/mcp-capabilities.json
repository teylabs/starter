{
    "inventory": 1,
    "server": {
        "name": "Workspace operations",
        "version": "0.1.0",
        "transport": "streamable-http",
        "endpoint": "/mcp/connections/{connection}",
        "auth": {
            "type": "oauth2",
            "flow": "authorization_code_pkce",
            "dynamic_client_registration": false,
            "binding": "one approved workspace connection per token"
        }
    },
    "scopes": {
        "mcp:use": "Use workspace MCP",
        "settings.read": "Read workspace settings",
        "settings.write": "Update workspace settings",
        "notes.read": "Read workspace notes",
        "notes.write": "Create, update and delete workspace notes"
    },
    "tools": [
        {
            "name": "workspace_settings_read",
            "description": "Read settings and current version of the approved workspace.",
            "scope": "settings.read",
            "writes": false,
            "input_schema": {
                "type": "object",
                "properties": {}
            }
        },
        {
            "name": "workspace_settings_update",
            "description": "Update settings using the current version and stable intent key.",
            "scope": "settings.write",
            "writes": true,
            "input_schema": {
                "properties": {
                    "display_name": {
                        "type": "string"
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "expected_version": {
                        "minimum": 1,
                        "type": "integer"
                    },
                    "intent_key": {
                        "type": "string"
                    }
                },
                "type": "object",
                "required": [
                    "display_name",
                    "timezone",
                    "expected_version",
                    "intent_key"
                ]
            }
        },
        {
            "name": "workspace_notes_list",
            "description": "List notes in the approved workspace.",
            "scope": "notes.read",
            "writes": false,
            "input_schema": {
                "type": "object",
                "properties": {}
            }
        },
        {
            "name": "workspace_note_read",
            "description": "Read one note in the approved workspace.",
            "scope": "notes.read",
            "writes": false,
            "input_schema": {
                "properties": {
                    "id": {
                        "minimum": 1,
                        "type": "integer"
                    }
                },
                "type": "object",
                "required": [
                    "id"
                ]
            }
        },
        {
            "name": "workspace_note_create",
            "description": "Create a note with a stable intent key.",
            "scope": "notes.write",
            "writes": true,
            "input_schema": {
                "properties": {
                    "intent_key": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                },
                "type": "object",
                "required": [
                    "intent_key",
                    "body"
                ]
            }
        },
        {
            "name": "workspace_note_update",
            "description": "Update a note using its current version and stable intent key.",
            "scope": "notes.write",
            "writes": true,
            "input_schema": {
                "properties": {
                    "id": {
                        "minimum": 1,
                        "type": "integer"
                    },
                    "intent_key": {
                        "type": "string"
                    },
                    "expected_version": {
                        "minimum": 1,
                        "type": "integer"
                    },
                    "body": {
                        "type": "string"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "intent_key",
                    "expected_version",
                    "body"
                ]
            }
        },
        {
            "name": "workspace_note_delete",
            "description": "Delete a note using its current version and stable intent key.",
            "scope": "notes.write",
            "writes": true,
            "input_schema": {
                "properties": {
                    "id": {
                        "minimum": 1,
                        "type": "integer"
                    },
                    "intent_key": {
                        "type": "string"
                    },
                    "expected_version": {
                        "minimum": 1,
                        "type": "integer"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "intent_key",
                    "expected_version"
                ]
            }
        }
    ],
    "resources": [],
    "prompts": []
}
