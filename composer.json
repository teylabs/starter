{
    "name": "tey/starter",
    "description": "Tenant-aware Laravel starter built for the Tey Labs fleet.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "glhd/gretel": "^1.10",
        "inertiajs/inertia-laravel": "^3.0",
        "inertiaui/modal": "^3.1",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.17",
        "laravel/mcp": "^1.0",
        "laravel/nightwatch": "^1.30",
        "laravel/passport": "^13.10",
        "laravel/pennant": "^1.0",
        "league/flysystem-aws-s3-v3": "^3.29",
        "lorisleiva/laravel-actions": "^2.12",
        "resend/resend-php": "^1.17",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.13",
        "spatie/laravel-multitenancy": "^4.2",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-settings": "^3.9",
        "tey/concierge": "^0.8.2",
        "tey/kit": "dev-main#5619adf7d60f6e9ffa89fca311e59de11038c4e9",
        "tey/standards": "^0.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/tinker": "^3.0",
        "opis/json-schema": "^2.4",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.1",
        "pestphp/pest-plugin-drift": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "fixture:check": [
            "@php bin/check.php FoundationCheck",
            "@php bin/check.php BoundaryCheck",
            "@php bin/check.php IntentCheck",
            "@php bin/check.php OwnershipCheck",
            "@php bin/check.php ConciergeCheck"
        ],
        "setup": "@php bin/setup.php",
        "test": "@php vendor/bin/pest",
        "test:brand-env": "sh bin/fake-brand-env.sh",
        "test:browser": "@php vendor/bin/pest --configuration=tests/Browser/phpunit.xml tests/Browser/SignIn.php tests/Browser/FormActions.php tests/Browser/AuthCards.php tests/Browser/Account.php tests/Browser/People.php tests/Browser/Shell.php tests/Browser/Modals.php tests/Browser/Focus.php tests/Browser/FirstRun.php tests/Browser/Alert.php tests/Browser/Placeholder.php",
        "types:generate": "@php bin/generate-types.php",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
