APP_NAME="Workspace starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
DB_CONNECTION=sqlite
# DB_DATABASE=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
NIGHTWATCH_TOKEN=
# The workspace owner `php artisan concierge:owners --workspace=<key>` keeps on every deploy (docs/deploy.md).
# Set it per environment: one email per workspace; leave it empty locally, where `composer setup` makes the owner.
CONCIERGE_OWNERS=
