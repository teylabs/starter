APP_NAME="Workspace starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# The sender of mail: the app's name, and an address on your own domain.
MAIL_FROM_NAME="${APP_NAME}"
# System mail goes from the updates@ address (mail_from_address in config/brand.php): kit applies the brand to mail only once it has no placeholders left.
MAIL_FROM_ADDRESS=updates@example.com
DB_CONNECTION=sqlite
# DB_DATABASE=
# Sessions live in the database (the `sessions` table is migrated), so /me/security can list the devices a user is signed in on and sign the others out.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
# The cache store: file here; a platform with a database attached sets `database` (the cache tables are migrated). QUEUE_CONNECTION is sync unless you run workers (then `database`).
CACHE_STORE=file
# The cache key prefix follows APP_NAME; set CACHE_PREFIX to pin it.
# CACHE_PREFIX=
# QUEUE_CONNECTION=sync
NIGHTWATCH_TOKEN=
# The font set <x-kit::fonts /> loads: instrument (the default), instrument-inter or hanken.
KIT_FONTS=instrument
# The workspace owner `php artisan concierge:owners --workspace=<key>` keeps on every deploy (docs/deploy.md).
# Set it per environment: one email per workspace; leave it empty locally, where `composer setup` makes the owner.
CONCIERGE_OWNERS=
# One-click sign-in on /login as this account. Concierge offers it only when the app and the process are both `local`
# and config isn't cached; anywhere else the button is absent and /local-login is a 404. The email is
# `starter:first-owner`'s default; change it if you gave the owner another.
# One-click local sign-in is on whenever APP_ENV=local (as owner@example.com) and never anywhere else. Optional overrides:
# CONCIERGE_LOCAL_LOGIN=false
# CONCIERGE_LOCAL_LOGIN_EMAIL=owner@example.com

# The brand (logomark, accent, mail addresses, legal footer, credit line, private) lives in config/brand.php, not here: the product's name is APP_NAME.

# Avatars (and any media): the private `local` disk by default (storage/app/private); nothing needs storage:link. In production use the one
# private bucket: MEDIA_DISK=s3 with the bucket's AWS_* variables (AWS_BUCKET, AWS_DEFAULT_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# and AWS_ENDPOINT / AWS_USE_PATH_STYLE_ENDPOINT for S3-compatible storage). Avatars are served by the app's /avatars/{token} route.
MEDIA_DISK=local

# Laravel's image API (Illuminate\Support\Facades\Image, backed by intervention/image): gd or imagick.
IMAGE_DRIVER=imagick

# An invitation may be accepted by a signed-in account with a different (verified) email: "Join as ...". Set true to accept only the invited email.
# KIT_INVITES_MATCH_EMAIL=true

# Invitation emails are sent when a real mailer is configured (MAIL_MAILER other than log); the link is always shown once to the person who invited. Override:
# KIT_INVITES_DELIVER=true

# MCP connections are Passport tokens. Locally, `php artisan passport:keys` writes storage/oauth-{private,public}.key and these stay unset.
# In production, set the signing keys as a PEM, a PEM with \n escapes or base64 (see .env.production.example).
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
