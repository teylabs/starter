APP_NAME="Workspace starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# The sender of mail: the app's name, and an address on your own domain.
MAIL_FROM_NAME="${APP_NAME}"
DB_CONNECTION=sqlite
# DB_DATABASE=
# Sessions live in the database (the `sessions` table is migrated), so /me/security can list the devices a user is signed in on and sign the others out.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
NIGHTWATCH_TOKEN=
# The font set <x-kit::fonts /> loads: instrument (the default), instrument-inter or hanken.
KIT_FONTS=instrument
# The workspace owner `php artisan concierge:owners --workspace=<key>` keeps on every deploy (docs/deploy.md).
# Set it per environment: one email per workspace; leave it empty locally, where `composer setup` makes the owner.
CONCIERGE_OWNERS=
# One-click sign-in on /login as this account. Concierge offers it only when the app and the process are both `local`
# and config isn't cached; anywhere else the button is absent and /local-login is a 404. The email is
# `starter:first-owner`'s default; change it if you gave the owner another.
# One-click local sign-in is on whenever APP_ENV=local (as owner@example.com) and never anywhere else. Optional overrides:
# CONCIERGE_LOCAL_LOGIN=false
# CONCIERGE_LOCAL_LOGIN_EMAIL=owner@example.com

# The brand (the product's name is APP_NAME). These placeholders work locally; replace them before you deploy: kit's
# Brand::placeholders() lists what is left. `php artisan kit:brand` makes the favicons, touch icon, mail mark and social
# image from the logomark and accent.
KIT_BRAND_LOGOMARK=/logomark.svg
KIT_BRAND_ACCENT=#52525b
# The four address roles: updates@ is the From of system mail, support@ its Reply-To and the help link, hello@ general
# contact, privacy@ data requests (left out of a private app).
KIT_BRAND_HELLO_EMAIL=hello@example.com
KIT_BRAND_SUPPORT_EMAIL=support@example.com
KIT_BRAND_PRIVACY_EMAIL=privacy@example.com
KIT_BRAND_MAIL_FROM_ADDRESS=updates@example.com
KIT_BRAND_LEGAL_NAME="Example Company"
KIT_BRAND_POSTAL_ADDRESS="1 Example Street, Example City"
KIT_BRAND_TERMS_URL=/terms
KIT_BRAND_PRIVACY_URL=/privacy
# The footer's credit line: "Built by Tey Labs". A client build overrides these.
KIT_BRAND_CREDIT_VERB=Built
KIT_BRAND_CREDIT_ORG="Tey Labs"
# KIT_BRAND_CREDIT_FOR=

# Avatars (and any media): the private `local` disk by default (storage/app/private); nothing needs storage:link. In production use the one
# private bucket: MEDIA_DISK=s3 with the bucket's AWS_* variables (AWS_BUCKET, AWS_DEFAULT_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# and AWS_ENDPOINT / AWS_USE_PATH_STYLE_ENDPOINT for S3-compatible storage). Avatars are served by the app's /avatars/{token} route.
MEDIA_DISK=local

# Brand variants. The default is a neutral zinc. A brand sets KIT_BRAND_ACCENT, and may set the accent's companions (each #rrggbb):
# KIT_BRAND_ACCENT_FOREGROUND (text on the accent), KIT_BRAND_ACCENT_STRONG (the accent as links and focus on white: 4.5:1),
# KIT_BRAND_ACCENT_DARK (fills in dark mode) and KIT_BRAND_STYLE=fill|mono (mono: an ink header and primary buttons, the accent only a highlight).
# To compare variants side by side in a LOCAL environment, name them here as JSON and open any page with ?brand=<name> (?brand= clears it);
# the switch is ignored everywhere else. Keep a client's own values in its own environment, not in this file.
# KIT_BRAND_PRESETS={"example":{"accent":"#2563eb","accent_foreground":"#ffffff","accent_strong":"#1d4ed8","accent_dark":"#60a5fa"}}

# A private app (an internal tool or a client's own workspace) has no public legal entity: with this on, the legal name, postal address, Terms and
# Privacy are left out of the web and mail footers, and `php artisan kit:brand` does not ask for them. A part left empty is omitted either way.
KIT_BRAND_PRIVATE=false

# An invitation may be accepted by a signed-in account with a different (verified) email: "Join as ...". Set true to accept only the invited email.
# KIT_INVITES_MATCH_EMAIL=true

# Invitation emails are sent when a real mailer is configured (MAIL_MAILER other than log); the link is always shown once to the person who invited. Override:
# KIT_INVITES_DELIVER=true
