#!/usr/bin/env bash
# Prepares a fresh checkout for a cloud agent: PHP 8.5 (with the extensions CI uses), Composer, a PostgreSQL server and
# Node 24, then `composer setup`. The tests read .env.testing: PostgreSQL on 127.0.0.1 as `root` with no password,
# database starter_testing (wiped by the suite; each parallel worker creates its own copy).
set -euo pipefail

PHP_EXTENSIONS=(mbstring xml curl zip pgsql pdo_pgsql sqlite3 pdo_sqlite intl bcmath gd imagick exif sockets)  # CI's list plus the app's; exif and sockets ship in php8.5-common
php_ready() {
    command -v php >/dev/null && php -r 'exit(PHP_VERSION_ID >= 80500 ? 0 : 1);' || return 1
    local loaded
    loaded=$(php -m | tr '[:upper:]' '[:lower:]')
    for extension in "${PHP_EXTENSIONS[@]}"; do
        grep -qx "$extension" <<<"$loaded" || return 1
    done
}
if ! php_ready; then
    sudo add-apt-repository -y ppa:ondrej/php
    sudo apt-get update
    sudo apt-get install -y php8.5-cli php8.5-mbstring php8.5-xml php8.5-curl php8.5-zip php8.5-pgsql php8.5-sqlite3 \
        php8.5-intl php8.5-bcmath php8.5-gd php8.5-imagick php8.5-pcov unzip
fi

# composer.lock needs composer-runtime-api ^2.2.
composer_ready() {
    command -v composer >/dev/null || return 1
    composer --version 2>/dev/null | grep -Eq 'Composer (version )?(2\.([2-9]|[1-9][0-9])|[3-9])\.'
}
if ! composer_ready; then
    curl -sS https://getcomposer.org/installer | php -- --install-dir=/tmp
    sudo mv /tmp/composer.phar /usr/local/bin/composer
fi

# Probe for the server, not the client: an image can ship psql without a server.
if ! compgen -G '/usr/lib/postgresql/*/bin/postgres' >/dev/null; then
    sudo apt-get update
    sudo apt-get install -y postgresql
fi
sudo service postgresql start
# The role .env.testing names. CREATEDB is all the suite needs (it creates the per-worker databases), so no superuser.
# An image may already have either: reconcile them rather than only creating when missing.
sudo -u postgres psql -tc "select 1 from pg_roles where rolname = 'root'" | grep -q 1 \
    || sudo -u postgres psql -c "create role root"
sudo -u postgres psql -c "alter role root login createdb nosuperuser nocreaterole noreplication nobypassrls"
sudo -u postgres psql -tc "select 1 from pg_database where datname = 'starter_testing'" | grep -q 1 \
    || sudo -u postgres createdb -O root starter_testing
sudo -u postgres psql -c "alter database starter_testing owner to root"
PG_HBA=$(sudo -u postgres psql -tAc "show hba_file")
# First match wins in pg_hba.conf: drop any root trust lines wherever they are, then put them first, above every
# password rule. Only `root`, only localhost.
sudo sed -i -E '/^host[[:space:]]+all[[:space:]]+root[[:space:]]+(127\.0\.0\.1\/32|::1\/128)[[:space:]]+trust/d' "$PG_HBA"
sudo sed -i '1i host all root 127.0.0.1/32 trust\nhost all root ::1/128 trust' "$PG_HBA"
sudo service postgresql reload

# package.json accepts ^22.12.0 || >=24.0.0; anything else gets Node 24.
node_ready() {
    command -v node >/dev/null || return 1
    node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>=24 || (a===22 && b>=12) ? 0 : 1)'
}
if ! node_ready; then
    curl -fsSL https://deb.nodesource.com/setup_24.x | sudo -E bash -
    sudo apt-get install -y nodejs
fi

composer setup
npx playwright install --with-deps chromium

# House rule: no AI attribution in commits. A repo-local commit-msg hook strips the trailers agents add (Amp-Thread-ID,
# Co-authored-by Amp/Claude/Anthropic, Claude-Session, "Generated with <AI tool>") and keeps human co-authors.
# Squash-merging stays the backstop. Repo-local only: never write into a global core.hooksPath (it may be the machine's
# own hooks). A commit-msg hook the repo already had is kept as commit-msg.local and still runs first.
# A core.hooksPath the repo already set is used only when it resolves inside this checkout (or its git dir);
# anything outside (a shared or machine-wide hooks folder) is left alone and $GIT_DIR/hooks is used instead.
TOP="$(git rev-parse --show-toplevel)"; GIT_DIR_ABS="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"  # shared by every worktree
HOOKS_DIR="$(git config --local --get core.hooksPath || true)"
case "$HOOKS_DIR" in ''|/*) ;; *) HOOKS_DIR="$TOP/$HOOKS_DIR" ;; esac
# Resolve without creating anything: realpath the nearest existing directory, then re-append the missing parts.
# A missing `.` or `..` part fails closed (an empty result counts as outside).
resolve() {
    local path="$1" rest=""
    while [ ! -d "$path" ]; do
        case "${path##*/}" in . | ..) return 0 ;; esac
        rest="/${path##*/}$rest"; path="${path%/*}"; [ -n "$path" ] || path="/"
    done
    printf '%s%s\n' "$(cd "$path" && pwd -P)" "$rest"
}
[ -n "$HOOKS_DIR" ] && HOOKS_DIR="$(resolve "$HOOKS_DIR")"
case "$HOOKS_DIR" in
    "$(cd "$TOP" && pwd -P)"|"$(cd "$TOP" && pwd -P)"/*|"$(cd "$GIT_DIR_ABS" && pwd -P)"|"$(cd "$GIT_DIR_ABS" && pwd -P)"/*) ;;
    *) HOOKS_DIR="$GIT_DIR_ABS/hooks" ;;
esac
mkdir -p "$HOOKS_DIR"
git config --local core.hooksPath "$HOOKS_DIR"
if [ -f "$HOOKS_DIR/commit-msg" ] && ! grep -q 'Installed by .agents/setup' "$HOOKS_DIR/commit-msg"; then
    if [ -e "$HOOKS_DIR/commit-msg.local" ]; then
        echo "setup: $HOOKS_DIR has both commit-msg and commit-msg.local; chain them by hand, then rerun." >&2
        exit 1
    fi
    mv "$HOOKS_DIR/commit-msg" "$HOOKS_DIR/commit-msg.local"
fi
cat > "$HOOKS_DIR/commit-msg" <<'HOOK'
#!/bin/sh
# Installed by .agents/setup: strip AI attribution trailers, keep human co-authors. Portable (POSIX awk).
set -e
local_hook="$(dirname "$0")/commit-msg.local"
[ -x "$local_hook" ] && "$local_hook" "$@"
tmp="$(mktemp "$(dirname "$1")/commit-msg.strip.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
awk '{
    l = tolower($0)
    if (l ~ /^amp-thread(-id)?:/) next
    if (l ~ /^claude-session:/) next
    # Co-authors: only known bot identities (by address domain or exact bot name); human co-authors are kept.
    if (l ~ /^co-authored-by:/ && l ~ /@(ampcode\.com|anthropic\.com|openai\.com)>/) next
    if (l ~ /^co-authored-by:[ \t]*(amp|claude|claude code|copilot|github copilot|codex)[ \t]*</) next
    if (l ~ /(generated|created) (with|by) / && l ~ /(claude|ampcode|(^|[^a-z])amp([^a-z]|$)|codex|openai|chatgpt|copilot|gemini|cursor|(^|[^a-z])ai([^a-z]|$))/) next
    if (l ~ /claude\.ai\/code\/session/) next
    print
}' "$1" > "$tmp" && mv "$tmp" "$1"
HOOK
chmod +x "$HOOKS_DIR/commit-msg"
