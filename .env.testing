# The test database: PostgreSQL, as production runs (Jasper's ruling, 2026-11-07). tests/environment.php reads the DB_* keys
# below for any the process environment leaves unset (CI sets its own). Each run wipes this database, and a parallel run
# gives each worker its own copy, `{DB_DATABASE}_w{token}`, created on first use. Never point it at a database you keep.
# These match Herd's PostgreSQL; DBngin or Postgres.app may need DB_USERNAME and DB_PASSWORD changed.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=starter_testing
DB_USERNAME=root
DB_PASSWORD=
