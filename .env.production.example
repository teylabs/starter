# What a production deploy sets, in the shape Laravel Cloud injects it. Copy it to a LOCAL, git-ignored file, replace every stand-in with the real value, and rehearse the deploy
# before the first one:  php artisan kit:preflight --env-file=path/to/that/file   (docs/deploy.md). Nothing in this file is a secret; nothing from your copy is printed.

APP_NAME="Your Product"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=base64:changeme-run-php-artisan-key-generate-show
APP_URL=https://your-product.example.com
LOG_CHANNEL=stderr

# PostgreSQL, as the platform's attached database injects it (or DB_URL).
DB_CONNECTION=pgsql
DB_HOST=changeme.db.example.com
DB_PORT=5432
DB_DATABASE=changeme
DB_USERNAME=changeme
DB_PASSWORD=changeme

# The cache, sessions and (optionally) the queue are in the database: their tables are migrations. QUEUE_CONNECTION is `sync` (jobs run in the request) or `database` (with a worker).
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync

# Mail goes through Resend (resend/resend-php is required by the starter). RESEND_KEY is the API key from the Resend dashboard.
MAIL_MAILER=resend
RESEND_KEY=re_changeme

# The OAuth signing keys for assistant connections: `php artisan passport:keys --show`-style PEM. A real multi-line PEM is best; the kit also accepts the form with the two characters
# backslash and n for each newline, or the whole PEM base64-encoded (when a dashboard cannot hold newlines). `php artisan kit:preflight` reports which form it found, never the key.
PASSPORT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
changeme-the-private-key-pem-body-with-real-newlines
-----END PRIVATE KEY-----"
PASSPORT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
changeme-the-public-key-pem-body-with-real-newlines
-----END PUBLIC KEY-----"

# Avatars and other media: the one private bucket.
MEDIA_DISK=local

# The brand an app must fill (php artisan kit:preflight and /up refuse the template's stand-ins in production). The product's name is APP_NAME.
KIT_BRAND_LOGOMARK=/logomark.svg
KIT_BRAND_ACCENT=#52525b
KIT_BRAND_HELLO_EMAIL=hello@example.com
KIT_BRAND_SUPPORT_EMAIL=support@example.com
KIT_BRAND_PRIVACY_EMAIL=privacy@example.com
KIT_BRAND_MAIL_FROM_ADDRESS=updates@example.com
KIT_BRAND_LEGAL_NAME="Example Company"
KIT_BRAND_POSTAL_ADDRESS="1 Example Street, Example City"
